<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.elevadorcom.ioritv.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_cadastros"
        android:name="com.elevadorcom.ioritv.ClientesFragment"
        android:label="Cadastros"
        tools:layout="@layout/fragment_clientes" />

    <fragment
        android:id="@+id/nav_financas"
        android:name="com.elevadorcom.ioritv.FinancasFragment"
        android:label="Finanças"
        tools:layout="@layout/fragment_financas" />

    <fragment
        android:id="@+id/nav_cliente_form"
        android:name="com.elevadorcom.ioritv.ClienteFormFragment"
        android:label="Cadastro"
        tools:layout="@layout/fragment_cliente_form">
        <argument
            android:name="clienteId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

</navigation>
