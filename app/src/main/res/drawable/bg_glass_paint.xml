<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora Frost backdrop: blobs difusos suaves em tons teal/azul.
     No Android 12+ (API 31+) o HomeActivity aplica RenderEffect blur,
     gerando vidro fosco REAL atrás dos cards translúcidos.
     Em versões anteriores, fallback automático para vidro translúcido.

     Paleta: blobs teal (#1B7A8C / #1E8C7A), índigo (#4B5E9E),
     luminância branca do topo, todos semitransparentes. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camada 1: Gradiente base aurora -->
    <item android:drawable="@drawable/bg_glass_gradient" />

    <!-- Camada 2: Luz indireta — glow suave do topo-central -->
    <item
        android:width="600dp"
        android:height="500dp"
        android:gravity="top|center_horizontal"
        android:top="-200dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00FFFFFF"
                android:gradientRadius="300dp"
                android:startColor="#12FFFFFF"
                android:type="radial" />
        </shape>
    </item>

    <!-- Camada 3: Blob teal claro (canto superior esquerdo) -->
    <item
        android:width="380dp"
        android:height="380dp"
        android:gravity="top|left"
        android:left="-140dp"
        android:top="-120dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#009BE7F2"
                android:gradientRadius="190dp"
                android:startColor="#309BE7F2"
                android:type="radial" />
        </shape>
    </item>

    <!-- Camada 4: Blob índigo suave (canto superior direito) -->
    <item
        android:width="340dp"
        android:height="340dp"
        android:gravity="top|right"
        android:right="-100dp"
        android:top="80dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00B9C6F0"
                android:gradientRadius="170dp"
                android:startColor="#28B9C6F0"
                android:type="radial" />
        </shape>
    </item>

    <!-- Camada 5: Blob teal-verde (canto inferior esquerdo) -->
    <item
        android:width="400dp"
        android:height="400dp"
        android:gravity="bottom|left"
        android:left="-160dp"
        android:bottom="-220dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00A8E8D4"
                android:gradientRadius="200dp"
                android:startColor="#20A8E8D4"
                android:type="radial" />
        </shape>
    </item>

    <!-- Camada 6: Blob teal profundo (canto inferior direito) -->
    <item
        android:width="360dp"
        android:height="360dp"
        android:gravity="bottom|right"
        android:right="-120dp"
        android:bottom="-160dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#001E8C7A"
                android:gradientRadius="180dp"
                android:startColor="#181E8C7A"
                android:type="radial" />
        </shape>
    </item>

</layer-list>
