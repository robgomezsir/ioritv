<?xml version="1.0" encoding="utf-8"?>
<!-- GlassCard background: superfície translúcida com borda sutil.
     Quando glass está ativado: vidro translúcido.
     Quando desativado: card Material padrão com surfaceContainerLow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_surface" />
    <corners android:radius="@dimen/shape_large" />
    <stroke
        android:width="@dimen/glass_border_width"
        android:color="@color/glass_outline_variant" />
</shape>
