<?xml version="1.0" encoding="utf-8"?>
<!-- GlassCard dialog PREMIUM (PRD 9.3 + screenshot):
     Superfície mais opaca (surfaceStrong 35%) + sheen premium + borda luminosa -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camada 1: Superfície sólida para dialogs (35% branco) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_surface_container_high" />
            <corners android:radius="@dimen/shape_extra_large" />
        </shape>
    </item>

    <!-- Camada 2: Sheen specular premium (mais visível no topo) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_sheen_start"
                android:endColor="@color/glass_sheen_end"
                android:type="linear" />
            <corners android:radius="@dimen/shape_extra_large" />
        </shape>
    </item>

</layer-list>
