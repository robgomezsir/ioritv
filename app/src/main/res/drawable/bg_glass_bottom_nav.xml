<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom Navigation Glass PREMIUM (conforme screenshot Papecon):
     Gradiente vertical de profundidade: translúcido no topo → mais opaco embaixo.
     Cria a sensação de profundidade e "grounding" vista no screenshot. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#00000000"
        android:centerColor="#33000000"
        android:endColor="#66000000"
        android:type="linear" />
</shape>
