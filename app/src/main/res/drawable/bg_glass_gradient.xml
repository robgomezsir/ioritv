<?xml version="1.0" encoding="utf-8"?>
<!-- Gradiente base da Aurora Frost — fundo com subtom teal profundo.
     No tema claro usa os tons claros do PRD; no escuro, os tons escuros.
     Este drawable é referenciado via bg_glass_paint.xml. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:angle="160"
        android:startColor="@color/glass_gradient_start"
        android:centerColor="@color/glass_gradient_mid"
        android:endColor="@color/glass_gradient_end"
        android:type="linear" />
</shape>
