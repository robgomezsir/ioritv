    <style name="TextAppearance.IORITv.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">11sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Display Styles -->
    <style name="TextAppearance.IORITv.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">57sp</item>
        <item name="android:lineHeight">64sp</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="TextAppearance.IORITv.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">45sp</item>
        <item name="android:lineHeight">52sp</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="TextAppearance.IORITv.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
