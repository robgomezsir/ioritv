<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilos existentes mantidos -->
    
    <!-- Estilo para SearchView -->
    <style name="CustomSearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:background">@drawable/search_view_background</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="queryBackground">@null</item>
        <item name="searchHintIcon">@null</item>
    </style>

    <!-- Estilo personalizado para AlertDialog com contraste adequado -->
    <style name="AlertDialogCustom" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorOnPrimary">?attr/colorOnPrimary</item>
        <item name="colorSecondary">?attr/colorSecondary</item>
        <item name="colorOnSecondary">?attr/colorOnSecondary</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertDialogButtonPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertDialogButton</item>
    </style>
    
    <!-- Estilo para botões do AlertDialog -->
    <style name="AlertDialogButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/md_theme_light_primary</item>
        <item name="rippleColor">@color/md_theme_light_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    
    <!-- Estilo para botão positivo (Salvar) -->
    <style name="AlertDialogButtonPositive" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/md_theme_light_onPrimary</item>
        <item name="backgroundTint">@color/md_theme_light_primary</item>
        <item name="rippleColor">@color/md_theme_light_onPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>
    
    <!-- Estilo personalizado para TextInputLayout -->
    <style name="CustomTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="boxStrokeColor">@color/text_input_stroke_light</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="helperTextTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="errorTextColor">?attr/colorError</item>
        <item name="boxCornerRadiusTopStart">@dimen/shape_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/shape_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/shape_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/shape_medium</item>
    </style>

    <!-- Estilo para Cards - Light -->
    <style name="WhatsAppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/shape_medium</item>
        <item name="cardElevation">@dimen/elevation_level1</item>
        <item name="android:layout_margin">@dimen/spacing_small</item>
        <item name="cardBackgroundColor">@color/surface_translucent</item>
    </style>

    <!-- Estilo para botões primários - Light -->
    <style name="WhatsAppButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/md_theme_light_primaryContainer</item>
        <item name="android:textColor">@color/md_theme_light_onPrimaryContainer</item>
        <item name="cornerRadius">@dimen/shape_medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Estilo para FloatingActionButton - Light -->
    <style name="WhatsAppFAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/md_theme_light_primaryContainer</item>
        <item name="tint">@color/white</item>
        <item name="elevation">@dimen/elevation_level4</item>
        <item name="pressedTranslationZ">@dimen/elevation_level5</item>
    </style>

    <!-- Estilo para Toolbar - Light -->
    <!-- NOTA: android:background NÃO deve estar aqui — é setado programaticamente no HomeActivity -->
    <style name="WhatsAppToolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/md_theme_light_onSurface</item>
        <item name="subtitleTextColor">@color/md_theme_light_onSurfaceVariant</item>
        <item name="navigationIconTint">@color/md_theme_light_onSurface</item>
        <item name="android:elevation">@dimen/elevation_level0</item>
    </style>

    <!-- Estilo para abas da BottomNavigationView -->
    <style name="BottomNavTabStyle" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Estilo para PopupMenu com cantos arredondados -->
    <style name="PopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
        <item name="android:popupElevation">@dimen/elevation_level3</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         GlassCard (PRD 9.1) - Card translúcido com borda e sombra
         ═══════════════════════════════════════════════════════════════ -->
    <style name="GlassCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/shape_large</item>
        <item name="cardElevation">@dimen/elevation_level1</item>
        <item name="android:layout_margin">@dimen/spacing_small</item>
        <item name="strokeWidth">@dimen/glass_border_width</item>
        <item name="strokeColor">@color/glass_outline_variant</item>
        <item name="cardBackgroundColor">@color/surface_translucent</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         GlassCardPrimary - para cards de destaque (valor total, etc)
         ═══════════════════════════════════════════════════════════════ -->
    <style name="GlassCardPrimary" parent="GlassCard">
        <item name="cardElevation">@dimen/elevation_level2</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         GlassOutlinedButton (PRD 9.2)
         ═══════════════════════════════════════════════════════════════ -->
    <style name="GlassOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_glass_button_outlined</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:minHeight">@dimen/button_height_badge</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         EmptyStateCard (PRD 6.10)
         ═══════════════════════════════════════════════════════════════ -->
    <style name="EmptyStateCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/shape_large</item>
        <item name="cardElevation">@dimen/elevation_level0</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">@color/surface_translucent</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         Status Badge - Pago/Concluído
         ═══════════════════════════════════════════════════════════════ -->
    <style name="StatusBadgePaid">
        <item name="android:background">@drawable/bg_badge_status_paid</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/status_paid_color</item>
        <item name="android:textSize">@dimen/text_badge</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         Status Badge - Pendente
         ═══════════════════════════════════════════════════════════════ -->
    <style name="StatusBadgePending">
        <item name="android:background">@drawable/bg_badge_status_pending</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/status_pending_color</item>
        <item name="android:textSize">@dimen/text_badge</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         Section Title Label (PRD 4.2)
         ═══════════════════════════════════════════════════════════════ -->
    <style name="SectionTitleLabel">
        <item name="android:textSize">@dimen/text_section_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════════
         Material3 Dialog Theme (PRD 6.7)
         Fundo surfaceContainerHigh, cantos extraLarge, sem bordas
         ═══════════════════════════════════════════════════════════════ -->
    <style name="Theme.IORITv.MaterialDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/colorSurfaceContainerHigh</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
        <item name="colorOnPrimary">?attr/colorOnPrimary</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.IORITv.Dialog</item>
    </style>

    <style name="ShapeAppearance.IORITv.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- MaterialDatePicker Theme - título bold -->
    <style name="Theme.IORITv.MaterialDatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="materialCalendarHeaderTitle">@style/MaterialDatePickerTitleBold</item>
    </style>

    <style name="MaterialDatePickerTitleBold">
        <item name="android:textStyle">bold</item>
    </style>

</resources>